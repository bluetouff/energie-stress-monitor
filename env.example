# /etc/energie/env  — clés API du moniteur de stress énergétique
# Déploiement : chmod 640, chown root:energie  (jamais lisible par www-data ni par le navigateur)
# builder.py lit ces clés, calcule, et n'écrit que snapshot.json (valeurs dérivées, zéro secret).

# EIA API v2 — https://www.eia.gov/opendata/register.php  (gratuit, clé immédiate)
EIA_KEY=

# GIE AGSI+ — https://agsi.gie.eu/account  (gratuit, envoyée en header x-key)
GIE_KEY=

# ENTSO-E Transparency — créer un compte sur transparency.entsoe.eu puis demander
# l'accès API par mail à transparency@entsoe.eu (délai ~1-2 j ouvrés). Optionnel :
# sans token, les prix élec FR/DE sont marqués indisponibles et exclus du composite.
ENTSOE_TOKEN=

# Chemin de sortie du snapshot (servi par Apache)
ENERGIE_OUT=/var/www/html/energie/snapshot.json

# Timeout HTTP par requête (secondes)
ENERGIE_TIMEOUT=25

# Les appels EIA sont plafonnés à un contrôle toutes les 4 h par série.
# Le cache ne contient que les valeurs publiques validées, jamais la clé.
ENERGIE_EIA_MIN_REFRESH_SECONDS=14400
ENERGIE_EIA_CACHE_DIR=/var/cache/energie/eia

# Ancienneté (jours) au-delà de laquelle une carte pétrole est marquée "stale".
# Ne vise que les vraies pannes, pas le délai de publication EIA : défaut 10 j.
# ENERGIE_STALE_MAX_AGE=10

# Au-delà de 3 jours, le point reste valide mais est signalé official-delayed.
# ENERGIE_EIA_OIL_DELAY_DAYS=3

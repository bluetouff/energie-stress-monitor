[Unit]
Description=Refresh energy stress snapshot every 30 min (l0g.fr)

[Timer]
# Le cycle court sert les sources intrajournalières. Le builder plafonne les
# contrôles EIA à un toutes les 4 h par série via son cache atomique.
OnBootSec=3min
OnUnitActiveSec=30min
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
